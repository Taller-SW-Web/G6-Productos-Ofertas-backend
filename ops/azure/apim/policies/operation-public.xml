<policies>
  <inbound>
    <base />
    <return-response>
      <set-status code="403" reason="Forbidden" />
      <set-header name="Content-Type" exists-action="override">
        <value>application/problem+json</value>
      </set-header>
      <set-body>{"type":"/errores/scope-insuficiente","title":"Acceso anónimo deshabilitado","status":403,"code":"SCOPE_INSUFICIENTE"}</set-body>
    </return-response>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
