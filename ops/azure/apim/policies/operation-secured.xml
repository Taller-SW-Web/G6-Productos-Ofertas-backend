<policies>
  <inbound>
    <base />
    <validate-jwt header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized" require-scheme="Bearer" output-token-variable-name="jwt">
      <openid-config url="{{g7-openid-config-url}}" />
      <issuers><issuer>{{g7-issuer}}</issuer></issuers>
      {{audience-check-element}}
    </validate-jwt>
    <set-variable name="rateIdentity" value="@(((Jwt)context.Variables[&quot;jwt&quot;]).Subject ?? string.Empty)" />
    <choose>
      <when condition="@((string)context.Variables[&quot;rateIdentity&quot;] == string.Empty)">
        <return-response>
          <set-status code="401" reason="Unauthorized" />
          <set-header name="Content-Type" exists-action="override"><value>application/problem+json</value></set-header>
          <set-header name="x-correlation-id" exists-action="override"><value>@((string)context.Variables[&quot;correlationId&quot;])</value></set-header>
          <set-body>{"type":"about:blank","title":"No autorizado","status":401,"code":"TOKEN_INVALIDO"}</set-body>
        </return-response>
      </when>
    </choose>
    <set-variable name="expectedIdentityType" value="{{identity-type}}" />
    <set-variable name="requiredRolesCsv" value="{{required-roles}}" />
    <set-variable name="requiredScopesCsv" value="{{required-scopes}}" />
    <set-variable name="allowedClientsCsv" value="{{allowed-clients}}" />
    <set-variable name="m2mAudience" value="{{m2m-audience}}" />
    <choose>
      <when condition="@{
        var jwt = (Jwt)context.Variables["jwt"];
        var expectedType = (string)context.Variables["expectedIdentityType"];
        var tokenType = jwt.Claims.GetValueOrDefault("tipo", string.Empty);

        bool allowHuman = expectedType == "human" || expectedType == "human_or_m2m";
        bool allowM2m = expectedType == "m2m" || expectedType == "human_or_m2m";

        if (tokenType == "acceso" &amp;&amp; allowHuman) {
          var reqRolesCsv = (string)context.Variables["requiredRolesCsv"];
          if (!string.IsNullOrEmpty(reqRolesCsv)) {
            var requiredRoles = reqRolesCsv.Split(',', StringSplitOptions.RemoveEmptyEntries);
            var tokenRoles = jwt.Claims.GetValueOrDefault("roles", string.Empty).Split(new[] {' ', ','}, StringSplitOptions.RemoveEmptyEntries);
            if (!requiredRoles.Any(r => tokenRoles.Contains(r))) return true;
          }
          return false;
        }

        if (tokenType == "servicio" &amp;&amp; allowM2m) {
          var expectedAud = (string)context.Variables["m2mAudience"];
          if (!string.IsNullOrEmpty(expectedAud)) {
            var audiences = jwt.Audiences ?? Enumerable.Empty&lt;string&gt;();
            if (!audiences.Contains(expectedAud)) return true;
          }
          var reqScopesCsv = (string)context.Variables["requiredScopesCsv"];
          if (!string.IsNullOrEmpty(reqScopesCsv)) {
            var requiredScopes = reqScopesCsv.Split(',', StringSplitOptions.RemoveEmptyEntries);
            var tokenScopes = (jwt.Claims.GetValueOrDefault("scope", string.Empty) + " " + jwt.Claims.GetValueOrDefault("scp", string.Empty)).Split(new[] {' ', ','}, StringSplitOptions.RemoveEmptyEntries);
            if (!requiredScopes.Any(s => tokenScopes.Contains(s))) return true;
          }
          var clientsCsv = (string)context.Variables["allowedClientsCsv"];
          if (!string.IsNullOrEmpty(clientsCsv)) {
            var allowed = clientsCsv.Split(',', StringSplitOptions.RemoveEmptyEntries);
            var clientId = jwt.Claims.GetValueOrDefault("client_id", jwt.Claims.GetValueOrDefault("azp", jwt.Subject ?? string.Empty));
            if (!allowed.Contains(clientId)) return true;
          }
          return false;
        }

        return true;
      }">
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override"><value>application/problem+json</value></set-header>
          <set-header name="x-correlation-id" exists-action="override"><value>@((string)context.Variables[&quot;correlationId&quot;])</value></set-header>
          <set-body>{"type":"about:blank","title":"Permisos insuficientes","status":403,"code":"SCOPE_INSUFICIENTE"}</set-body>
        </return-response>
      </when>
    </choose>
    <rate-limit-by-key calls="{{burst-calls}}" renewal-period="{{burst-window-seconds}}" counter-key="@((string)context.Variables[&quot;rateIdentity&quot;] + &quot;:{{operation-id}}&quot;)" />
    <quota-by-key calls="{{quota-calls}}" renewal-period="{{quota-window-seconds}}" counter-key="@((string)context.Variables[&quot;rateIdentity&quot;] + &quot;:{{operation-id}}&quot;)" />
  </inbound>
  <backend>
    {{concurrency-limit-open}}
    <forward-request buffer-request-body="false" buffer-response="false" />
    {{concurrency-limit-close}}
  </backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
