# Node environment
NODE_ENV=development

# Microservices default HTTP ports (isolated for concurrent local execution)
API_GATEWAY_PORT=3000
CATALOG_SVC_PORT=3001
PRICING_SVC_PORT=3002
PRICE_AUDIT_SVC_PORT=3003
PROMOTIONS_SVC_PORT=3004
INVENTORY_SVC_PORT=3005
TAXONOMY_SVC_PORT=3006
COMBOS_SVC_PORT=3007
BULK_SVC_PORT=3008

# Generic fallback port
PORT=3000

# Temporary public demo exception: routes all registered Gateway operations without JWT.
# Keep false until demo-data isolation, least-privilege roles, backup/recovery,
# rate limits and exposure approval are evidenced. CORS is not API protection.
GATEWAY_DEMO_NO_AUTH_ENABLED=false

# Future integration placeholders (NO credentials in foundation)
# El acceso a base de datos del backend se realiza directamente via connection string / pooler PostgreSQL, no mediante supabase anon key del frontend.
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Seeds INFRA-001: ver scripts/seed/README.md. Configurar en la sesión/gestor de secretos.
# Destino existente compartido: solo verificaciones transaccionales con ROLLBACK.
# SEED_ENVIRONMENT=shared
# SEED_PROJECT_REF=slzglmtiyrzygpkiuthf
# PGHOST=db.slzglmtiyrzygpkiuthf.supabase.co
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=seed_cueva
# PGPASSWORD=<configurar fuera de Git>; alternativa: PGPASSFILE protegido fuera del repo.
# PGSSLMODE=verify-full
# PGSSLROOTCERT=C:/ruta/privada/supabase-ca.crt
