# Plantilla; configurar variables en la sesión/gestor de secretos. No se carga automáticamente.
# Proyecto existente autorizado para pruebas con ROLLBACK.
SEED_ENVIRONMENT=shared
SEED_PROJECT_REF=slzglmtiyrzygpkiuthf
PGHOST=db.slzglmtiyrzygpkiuthf.supabase.co
PGPORT=5432
PGDATABASE=postgres
# Login individual de carga: provisionar y obtener usuario exacto desde Connect.
PGUSER=seed_cueva
# PGPASSWORD=<configurar fuera de Git>
# O un archivo de contraseñas protegido fuera del repositorio:
# PGPASSFILE=C:/ruta/privada/seed.pgpass
PGSSLMODE=verify-full
PGSSLROOTCERT=C:/ruta/privada/supabase-ca.crt
