{
  "name": "g6-productos-ofertas-backend",
  "version": "0.0.1",
  "description": "Monorepo backend NestJS para Productos y Ofertas (G6)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "build:all": "tsc --build",
    "build:api-gateway": "nest build api-gateway",
    "build:catalog-svc": "nest build catalog-svc",
    "build:pricing-svc": "nest build pricing-svc",
    "build:price-audit-svc": "nest build price-audit-svc",
    "build:promotions-svc": "nest build promotions-svc",
    "build:inventory-svc": "nest build inventory-svc",
    "build:taxonomy-svc": "nest build taxonomy-svc",
    "build:combos-svc": "nest build combos-svc",
    "build:bulk-svc": "nest build bulk-svc",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:api-gateway": "nest start api-gateway",
    "start:catalog-svc": "nest start catalog-svc",
    "start:pricing-svc": "nest start pricing-svc",
    "start:price-audit-svc": "nest start price-audit-svc",
    "start:promotions-svc": "nest start promotions-svc",
    "start:inventory-svc": "nest start inventory-svc",
    "start:taxonomy-svc": "nest start taxonomy-svc",
    "start:combos-svc": "nest start combos-svc",
    "start:bulk-svc": "nest start bulk-svc",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "oxlint apps/",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}