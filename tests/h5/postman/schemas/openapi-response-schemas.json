{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G6 H5 OpenAPI 0.7.0-rc.3 Response Schemas",
  "sourceContract": "contratos/http/openapi.yaml",
  "sourceVersion": "0.7.0-rc.3",
  "$defs": {
    "Canal": {
      "type": "string",
      "enum": ["MARKETPLACE", "CHATBOT", "RETAIL", "VENTAS"]
    },
    "EstadoStock": {
      "type": "string",
      "enum": ["DISPONIBLE", "STOCK_BAJO", "AGOTADO", "INDETERMINADO"]
    },
    "ProductoResumenComercial": {
      "type": "object",
      "required": ["product_id", "slug", "name", "categoria_id", "tipo_producto_id", "marca_id", "tiene_variantes"],
      "properties": {
        "product_id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "categoria_id": { "type": "string", "minLength": 1 },
        "tipo_producto_id": { "type": "string", "minLength": 1 },
        "marca_id": { "type": "string", "minLength": 1 },
        "tiene_variantes": { "type": "boolean" },
        "sku_base": { "type": ["string", "null"] },
        "images": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "attributes": { "type": "array" }
      }
    },
    "VarianteComercial": {
      "type": "object",
      "required": ["variant_id", "sku"],
      "properties": {
        "variant_id": { "type": "string", "minLength": 1 },
        "sku": { "type": "string", "minLength": 1 },
        "identifying_attributes": { "type": "array" },
        "non_identifying_attributes": { "type": "array" },
        "images": { "type": "array", "items": { "type": "string", "format": "uri" } }
      }
    },
    "ProductoDetalleComercial": {
      "type": "object",
      "required": ["product_id", "slug", "name", "categoria_id", "tipo_producto_id", "marca_id", "tiene_variantes", "marca", "variants"],
      "properties": {
        "product_id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "categoria_id": { "type": "string", "minLength": 1 },
        "tipo_producto_id": { "type": "string", "minLength": 1 },
        "marca_id": { "type": "string", "minLength": 1 },
        "tiene_variantes": { "type": "boolean" },
        "sku_base": { "type": ["string", "null"] },
        "marca": {
          "type": "object",
          "required": ["marca_id", "name"],
          "properties": {
            "marca_id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "variants": { "type": "array", "items": { "$ref": "#/$defs/VarianteComercial" } }
      }
    },
    "PaginaProductosComercial": {
      "type": "object",
      "required": ["items", "pagina", "tamanio", "total"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/ProductoResumenComercial" } },
        "pagina": { "type": "integer", "minimum": 1 },
        "tamanio": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "Precio": {
      "type": "object",
      "required": ["sku", "precio_regular", "currency", "channel_id", "valid_from", "price_version", "vigencia_id", "origen"],
      "properties": {
        "sku": { "type": "string", "minLength": 1 },
        "precio_regular": { "type": "number", "exclusiveMinimum": 0 },
        "precio_oferta": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "currency": { "type": "string", "minLength": 1 },
        "channel_id": { "type": ["string", "null"], "enum": ["MARKETPLACE", "CHATBOT", "RETAIL", "VENTAS", null] },
        "valid_from": { "type": "string", "minLength": 1, "format": "date-time" },
        "valid_until": { "type": ["string", "null"], "format": "date-time" },
        "price_version": { "type": "integer", "minimum": 0 },
        "vigencia_id": { "type": "string", "minLength": 1 },
        "origen": { "type": "string", "enum": ["PRODUCTO", "SKU_OVERRIDE"] }
      }
    },
    "ConsultaPrecios": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/Precio" } }
      }
    },
    "DisponibilidadStock": {
      "type": "object",
      "required": ["sku", "on_hand", "reserved", "blocked", "available", "status"],
      "properties": {
        "sku": { "type": "string", "minLength": 1 },
        "location_id": { "type": ["string", "null"] },
        "on_hand": { "type": "integer", "minimum": 0 },
        "reserved": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "available": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/$defs/EstadoStock" },
        "threshold": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "ConsultaDisponibilidadResponse": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/DisponibilidadStock" } }
      }
    },
    "DisponibilidadComercial": {
      "type": "object",
      "required": ["sku", "status"],
      "additionalProperties": false,
      "properties": {
        "sku": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/EstadoStock" }
      }
    },
    "ConsultaDisponibilidadComercialResponse": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/DisponibilidadComercial" } }
      }
    },
    "Problem": {
      "type": "object",
      "required": ["title", "status", "code"],
      "properties": {
        "type": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "detail": { "type": "string" },
        "code": {
          "type": "string",
          "minLength": 1,
          "enum": ["VALIDACION","TOKEN_INVALIDO","SCOPE_INSUFICIENTE","VERSION_CONFLICT","IDEMPOTENCY_CONFLICT","ERROR_INTERNO","SERVICIO_NO_DISPONIBLE","OPERACION_MAESTRA_NO_ENCONTRADA","AUDITORIA_PRECIO_NO_ENCONTRADA","LIMITE_EXPORTACION_AUDITORIA_EXCEDIDO","PRODUCTO_NO_ENCONTRADO","SKU_DUPLICADO","CATEGORIA_INVALIDA","TIPO_PRODUCTO_INVALIDO","TIPO_PRODUCTO_NO_ENCONTRADO","MARCA_INVALIDA","DATOS_INCOMPLETOS","CAMBIO_ESTRUCTURAL_NO_PERMITIDO","PERFIL_FISICO_INVALIDO","DATOS_FISICOS_INCOMPLETOS","VARIANTE_NO_ENCONTRADA","PRODUCTO_NO_ADMITE_VARIANTES","COMBINACION_DUPLICADA","SKU_INVALIDO","ATRIBUTO_IDENTIFICADOR_INVALIDO","IMAGEN_INVALIDA","SKU_NO_ENCONTRADO","UBICACION_NO_ENCONTRADA","CANTIDAD_INVALIDA","SKU_INACTIVO","STOCK_INSUFICIENTE","RESERVA_NO_ENCONTRADA","OPERACION_INVENTARIO_NO_ENCONTRADA","CONTEXTO_ABASTECIMIENTO_INVALIDO","RESERVA_NO_ACTIVA","RESERVA_EXPIRADA","PRECIO_NO_ENCONTRADO","PRECIO_INVALIDO","OFERTA_INVALIDA","MOTIVO_CAMBIO_REQUERIDO","VIGENCIA_SUPERPUESTA","ACCION_OFERTA_INVALIDA","SCOPE_PRECIO_INVALIDO","PROMOCION_NO_ENCONTRADA","PROMOCION_INVALIDA","PROMOCION_INACTIVA","ALCANCE_PROMOCION_INVALIDO","CUSTOMER_REF_REQUERIDO","LIMITE_CUPON_INVALIDO","CUPON_DUPLICADO","COMBO_NO_ENCONTRADO","COMBO_ANIDADO_NO_PERMITIDO","COMBO_COMPONENTES_INSUFICIENTES","COMBO_COMPONENTE_DUPLICADO","COMBO_PRECIO_INVALIDO","REGLA_RECOMENDACION_NO_ENCONTRADA","REGLA_RECOMENDACION_INVALIDA","PRODUCTO_RECOMENDADO_INVALIDO","CATEGORIA_NO_ENCONTRADA","CATEGORIA_DUPLICADA","PROFUNDIDAD_CATEGORIA_EXCEDIDA","CICLO_CATEGORIA","CATEGORIA_PADRE_INACTIVA","CATEGORIA_CON_SUBCATEGORIAS_ACTIVAS","ENTIDAD_MAESTRA_CON_PRODUCTOS_ACTIVOS","BAJA_MAESTRA_EN_PROCESO","MARCA_NO_ENCONTRADA","MARCA_DUPLICADA","LOGO_INVALIDO","LOGO_EXCEDE_LIMITE","CARACTERISTICA_NO_ENCONTRADA","TIPO_CARACTERISTICA_INMUTABLE","VALOR_LISTA_LIMITE_EXCEDIDO","TEXTO_ATRIBUTO_EXCEDE_LIMITE","VALOR_NUMERICO_INVALIDO","VALOR_LISTA_EN_USO","ASOCIACION_NO_ENCONTRADA","ASOCIACION_DUPLICADA","LIMITE_CARACTERISTICAS_EXCEDIDO","ASOCIACION_EN_USO","SLUG_NO_ENCONTRADO","SLUG_DUPLICADO","METADATOS_SEO_INVALIDOS","ARCHIVO_INVALIDO","ARCHIVO_EXCEDE_LIMITE","PLANTILLA_INCOMPATIBLE","CONTENIDO_ACTIVO_NO_PERMITIDO","LOTE_NO_ENCONTRADO","CUPON_NO_ENCONTRADO","INCIDENCIA_NO_ENCONTRADA","INCIDENCIA_NO_ACTIVA","RESOLUCION_INCIDENCIA_INVALIDA","REINTEGRO_NO_APLICABLE","TRASLADO_NO_ENCONTRADO","TRASLADO_NO_RECIBIBLE","CANTIDAD_RECIBIDA_EXCEDE_TRASLADO","DISPOSICION_RECEPCION_INVALIDA","CODIGO_BARRAS_NO_ENCONTRADO","RATE_LIMIT_EXCEDIDO","PREPARACION_NO_REINTENTABLE"]
        },
        "correlationId": { "type": "string", "format": "uuid" }
      }
    }
  }
}
