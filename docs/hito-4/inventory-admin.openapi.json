{
  "openapi": "3.1.0",
  "info": {
    "title": "Inventario administrativo G6 · PROPUESTA_H4",
    "version": "0.6.0-h4-inventory-admin"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/inventario/administracion/saldos": {
      "get": {
        "operationId": "listarSaldosFisicosAdministracion",
        "summary": "Listar saldos físicos por SKU y ubicación",
        "security": [
          {
            "userBearer": []
          }
        ],
        "x-required-role": "GESTOR_COMERCIAL",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "name": "sku",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "locationId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "default": 1
            }
          },
          {
            "name": "tamanio",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "estado",
            "in": "query",
            "description": "Filtra por estado local calculado antes de paginar.",
            "schema": {
              "type": "string",
              "enum": [
                "AGOTADO",
                "STOCK_BAJO",
                "DISPONIBLE"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de saldos persistidos.",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaSaldosFisicos"
                }
              }
            }
          },
          "400": {
            "description": "VALIDACION",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "TOKEN_INVALIDO",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "SCOPE_INSUFICIENTE",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "ERROR_INTERNO",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "SERVICIO_NO_DISPONIBLE",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-error-codes": {
          "400": [
            "VALIDACION"
          ],
          "401": [
            "TOKEN_INVALIDO"
          ],
          "403": [
            "SCOPE_INSUFICIENTE"
          ],
          "500": [
            "ERROR_INTERNO"
          ],
          "503": [
            "SERVICIO_NO_DISPONIBLE"
          ]
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "userBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "CorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlationId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SaldoFisico": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "ubicacion",
          "skuActivo",
          "onHand",
          "reserved",
          "blocked",
          "available",
          "umbralEfectivo",
          "estado",
          "stockVersion",
          "actualizadoEn"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "ubicacion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locationId",
              "codigo",
              "nombre",
              "tipo",
              "activa"
            ],
            "properties": {
              "locationId": {
                "type": "string",
                "format": "uuid"
              },
              "codigo": {
                "type": "string",
                "minLength": 1
              },
              "nombre": {
                "type": "string",
                "minLength": 1
              },
              "tipo": {
                "type": "string",
                "minLength": 1
              },
              "activa": {
                "type": "boolean"
              }
            }
          },
          "skuActivo": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Último estado de ciclo de vida recibido. Nulo si Inventario no dispone de esa información."
          },
          "onHand": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reserved": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "blocked": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "available": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "umbralEfectivo": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "estado": {
            "enum": [
              "AGOTADO",
              "STOCK_BAJO",
              "DISPONIBLE"
            ],
            "description": "Estado del saldo en la ubicación, calculado según SPEC-016."
          },
          "stockVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "actualizadoEn": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PaginaSaldosFisicos": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "meta"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaldoFisico"
            }
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pagina",
              "tamanio",
              "total",
              "totalPaginas"
            ],
            "properties": {
              "pagina": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "tamanio": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "totalPaginas": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    }
  }
}
