  "components": {
    "securitySchemes": {
      "userBearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    },
    "parameters": {
      "CorrelationId": {
        "in": "header",
        "name": "X-Correlation-Id",
        "required": false,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      }
    },
    "schemas": {
      "ComboCreateRequest": {
        "additionalProperties": true,
        "properties": {
          "componentes": {
            "items": {
              "$ref": "#/components/schemas/ComboItemInput"
            },
            "minItems": 2,
            "type": "array"
          },
          "descripcion": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "nombre": {
            "minLength": 1,
            "type": "string"
          },
          "precioCombo": {
            "exclusiveMinimum": 0,
            "type": "number"
          }
        },
        "required": [
          "nombre",
          "componentes",
          "precioCombo"
        ],
        "type": "object"
      },
      "ComboItemInput": {
        "additionalProperties": true,
        "properties": {
          "cantidad": {
            "minimum": 1,
            "type": "integer"
          },
          "sku": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "sku",
          "cantidad"
        ],
        "type": "object"
      },
      "Combo": {
        "properties": {
          "calculated_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "combo_id": {
            "type": "string"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponenteCombo"
            },
            "minItems": 2,
            "type": "array"
          },
          "description": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "freshness": {
            "type": [
              "string",
              "null"
            ]
          },
          "informative_availability": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "price": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "status": {
            "enum": [
              "ACTIVO",
              "INACTIVO"
            ],
            "type": "string"
          },
          "version": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "combo_id",
          "status",
          "price",
          "components"
        ],
        "type": "object"
      },
      "ComponenteCombo": {
        "properties": {
          "quantity": {
            "minimum": 1,
            "type": "integer"
          },
          "sku": {
            "type": "string"
          }
        },
        "required": [
          "sku",
          "quantity"
        ],
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "correlationId": {
            "format": "uuid",
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "type": "object"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri-reference",
