    "taxonomy-svc": {
      "type": "application",
      "root": "apps/taxonomy-svc",
      "entryFile": "main",
      "sourceRoot": "apps/taxonomy-svc/src",
      "compilerOptions": {
        "tsConfigPath": "apps/taxonomy-svc/tsconfig.app.json"
      }
    }
  }
}