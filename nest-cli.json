      }
    },
    "price-audit-svc": {
      "type": "application",
      "root": "apps/price-audit-svc",
      "entryFile": "main",
      "sourceRoot": "apps/price-audit-svc/src",
      "compilerOptions": {
        "tsConfigPath": "apps/price-audit-svc/tsconfig.app.json"
      }
    },
    "pricing-svc": {
      "type": "application",
      "root": "apps/pricing-svc",
      "entryFile": "main",
      "sourceRoot": "apps/pricing-svc/src",
