# Configuración técnica de #106. No rellenar URLs o grants por inferencia.
API_GATEWAY_PORT=3000
GATEWAY_TIMEOUT_MS=5000
# Origins privados de servicios habilitados (sin path, query ni credenciales).
GATEWAY_CATALOG_SVC_URL=
GATEWAY_TAXONOMY_SVC_URL=
GATEWAY_PRICING_SVC_URL=
GATEWAY_PRICE_AUDIT_SVC_URL=
GATEWAY_PROMOTIONS_SVC_URL=
GATEWAY_COMBOS_SVC_URL=
GATEWAY_INVENTORY_SVC_URL=
GATEWAY_BULK_SVC_URL=
# Issuer exacto y JWKS HTTPS acordados con G7. Ambos o ninguno.
AUTH_ISSUER=
AUTH_JWKS_URL=
# Solo operationIds contractualmente anónimos y cuya exposición esté aprobada.
GATEWAY_PUBLIC_OPERATION_IDS=
