# Fuente: Docs ops/postgres-runtime/guia-desarrollo-local.md
# Copiar como apps/promotions-svc/.env.local y completar los campos privados.
NODE_ENV=development
PROMOTIONS_SVC_PORT=3004

# Session Pooler e identidad exclusiva de Promotions.
PGHOST=aws-0-sa-east-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=promotions_dev_login.slzglmtiyrzygpkiuthf
PGPASSWORD=
PGSSLMODE=verify-full
# Ruta absoluta al certificado descargado del proyecto en TU equipo.
# Ejemplo: C:/Users/<tu-usuario>/AppData/Local/G6/PostgresRuntime/supabase-server-root.crt
PGSSLROOTCERT=
G6_DATABASE_SCHEMA=promotions
G6_CONNECTION_MODE=session

# Configuración separada de PostgreSQL; usar el destino AMQP privado autorizado.
# No inventar una URL ni copiar credenciales de otro integrante.
RABBITMQ_URL=

# Opt-in: probes reales bajo demanda; no activan consumidores ni cargan DATA.
PROMOTIONS_DEPENDENCY_PROBES_ENABLED=false
# Mantener false hasta resolver evidencia, elegibilidad, dispatcher e identidad/ACL.
# true sin adaptadores autorizados rechaza el arranque antes de consumir/publicar.
PROMOTIONS_COUPON_RUNTIME_ENABLED=false

# Identidad de Seguridad para consultas HTTP. Omitir ambas mantiene esas rutas
# protegidas con 503; no afecta liveness. Si se configuran, se exigen juntas y HTTPS.
# Usar issuer y JWKS del entorno autorizado; no claves privadas ni token de usuario.
# AUTH_ISSUER=https://<seguridad>/api/v1/auth
# AUTH_JWKS_URL=https://<seguridad>/api/v1/auth/.well-known/jwks.json
